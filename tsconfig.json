{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "dist/esm",
    "sourceMap": true,
    "skipLibCheck": true,
    "module": "node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "target": "es2015",
    "lib": ["es2015", "dom"],
    "strict": true
  },
  "include": ["src/**/*.js", "src/**/*.ts", "index.d.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ]
}
