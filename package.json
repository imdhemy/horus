{
  "name": "horus",
  "version": "2.1.0",
  "description": "A JavaScript NES emulator",
  "homepage": "https://github.com/imdhemy/horus",
  "author": "Dhemy",
  "contributors": [
    "Ben Firshman <ben@firshman.com>"
  ],
  "main": "dist/jsnes.cjs",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/jsnes.cjs",
      "default": "./dist/esm/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/imdhemy/horus.git"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && webpack && tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && prettier --check '**/*.{js,jsx,ts,css}' && node --import tsx --test ./test/*.spec.js",
    "test:watch": "node --import tsx --test --watch ./test/*.spec.js",
    "vitest": "vitest --run",
    "prepublishOnly": "npm run build",
    "format": "prettier --write '**/*.{js,jsx,ts,css}'",
    "deploy": "wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-webpack-plugin": "^6.0.0",
    "prettier": "^3.6.2",
    "terser-webpack-plugin": "^5.3.10",
    "ts-loader": "^9.6.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "vitest": "^5.0.0",
    "webpack": "^5.100.2",
    "webpack-cli": "^7.0.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "eslint-webpack-plugin": {
      "eslint": "$eslint"
    }
  }
}
